{
  "name": "huddle",
  "productName": "Huddle",
  "version": "0.3.0",
  "description": "Standalone panel showing Claude Desktop sessions",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.huddle.app",
    "productName": "Huddle",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  }
}
